# Copiar a .env y completar. .env NUNCA se commitea (está en .gitignore).

# Proyecto Supabase "Ayni"
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contraseñas iniciales de los usuarios del sistema
PASS_MANAGER=
PASS_EMPLEADA=

# Usuarios del sistema (no son secretos, pero se configuran acá para no
# dejarlos fijos en el código). El usuario se normaliza a minúsculas.
USUARIO_MANAGER=
NOMBRE_MANAGER=
USUARIO_EMPLEADA=
NOMBRE_EMPLEADA=

# Opcional: si existe una cuenta previa con el mismo usuario en otro dominio
# (por ej. usuario@otrodominio.com), poner 1 para cambiarle el email al interno
# conservando el mismo id. Con 0 (o vacío) el script se detiene y avisa.
MIGRAR_EMAIL_EXISTENTE=0
